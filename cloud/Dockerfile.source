FROM node:24-bookworm-slim AS node
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 faixalab

COPY --from=node /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY app/requirements-source.txt ./requirements-source.txt
ARG YTDLP_VERSION=2026.11.04.232659dev
RUN pip install --no-cache-dir --pre -r requirements-source.txt "yt-dlp[default]==${YTDLP_VERSION}"
COPY app/faixalab/__init__.py app/faixalab/media.py app/faixalab/source_api.py app/faixalab/youtube_support.py ./faixalab/
RUN python -c "from faixalab.youtube_support import check_support; check_support()"

ENV PYTHONUNBUFFERED=1 \
    FAIXALAB_AUDIO_SOURCE_DATA=/tmp/faixalab-audio-source

USER faixalab
CMD ["python", "-m", "faixalab.source_api", "--host", "0.0.0.0"]
