FROM node:24-bookworm-slim AS node
FROM node AS youtube_source
WORKDIR /opt/youtube-source
COPY cloud/youtube-source/package.json cloud/youtube-source/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY cloud/youtube-source/extract.mjs ./

FROM brainicism/bgutil-ytdlp-pot-provider:2.0.2 AS bgutil
FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg libatomic1 libstdc++6 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 faixalab

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=youtube_source /opt/youtube-source /opt/youtube-source
COPY --from=bgutil /usr/local/bin/node /opt/bgutil-node
COPY --from=bgutil /app /opt/bgutil
WORKDIR /app
COPY app/requirements-source.txt ./requirements-source.txt
ARG YTDLP_VERSION=2026.11.04.232659dev
RUN pip install --no-cache-dir --pre -r requirements-source.txt \
    "yt-dlp[default]==${YTDLP_VERSION}" "bgutil-ytdlp-pot-provider==2.0.2"
RUN mkdir -p /opt/youtube-source/solver \
    && solver_dir=$(python -c 'from pathlib import Path; from yt_dlp_ejs.yt import solver; print(Path(solver.__file__).parent)') \
    && cp "$solver_dir/core.min.js" "$solver_dir/lib.min.js" /opt/youtube-source/solver/
COPY app/faixalab/__init__.py app/faixalab/media.py app/faixalab/source_api.py app/faixalab/youtube_support.py app/faixalab/pot_ab_test.py app/faixalab/youtube_native.py ./faixalab/
ENV PYTHONUNBUFFERED=1 \
    FAIXALAB_ENABLE_POT_AB=1 \
    FAIXALAB_YOUTUBE_EXTRACTOR=native \
    FAIXALAB_AUDIO_SOURCE_DATA=/tmp/faixalab-audio-source

USER faixalab
RUN python -m faixalab.pot_ab_test --check
RUN node --input-type=module -e "await import('/opt/youtube-source/extract.mjs')"
CMD ["python", "-m", "faixalab.source_api", "--host", "0.0.0.0"]
