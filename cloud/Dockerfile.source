FROM python:3.12-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl ffmpeg libgcc-s1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 1000 faixalab \
    && install -d -o faixalab -g faixalab /var/tmp/youtubei.js

ARG COMPANION_ASSET_ID=721765701
ARG COMPANION_SHA256=9865200a698b5b8e4797b04bbb3f3e4401cd1cec9816c260ffe7857a8903f0a4
RUN curl -fsSL --retry 2 --max-time 90 -H 'Accept: application/octet-stream' \
    "https://api.github.com/repos/iv-org/invidious-companion/releases/assets/${COMPANION_ASSET_ID}" \
    -o /tmp/companion.tar.gz \
    && printf '%s  %s\n' "${COMPANION_SHA256}" /tmp/companion.tar.gz | sha256sum -c \
    && tar -xzf /tmp/companion.tar.gz -C /usr/local/bin invidious_companion \
    && rm /tmp/companion.tar.gz

WORKDIR /app
COPY app/requirements-source.txt ./requirements-source.txt
RUN pip install --no-cache-dir -r requirements-source.txt 'httpx>=0.28,<1'
COPY app/faixalab/__init__.py app/faixalab/media.py app/faixalab/source_api.py app/faixalab/youtube_support.py app/faixalab/youtube_native.py app/faixalab/youtube_companion.py ./faixalab/
ENV PYTHONUNBUFFERED=1 \
    FAIXALAB_YOUTUBE_EXTRACTOR=companion \
    FAIXALAB_RUN_COMPANION_TRIAL=1 \
    FAIXALAB_AUDIO_SOURCE_DATA=/tmp/faixalab-audio-source

USER faixalab
RUN python -c 'import faixalab.youtube_companion'
CMD ["python", "-m", "faixalab.source_api", "--host", "0.0.0.0"]
